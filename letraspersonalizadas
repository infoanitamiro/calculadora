<!DOCTYPE html>

<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculadora de Letras — Anita Miró Ceramics</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
–cream: #faf5ee;
–warm-white: #fffcf7;
–blush: #f2e8df;
–terracota: #c4714a;
–ink: #1e1810;
–ink-soft: #6b5b4e;
–border: #e5d9cc;
–wa-green: #25D366;
}

body {
background: var(–cream);
font-family: ‘Jost’, sans-serif;
color: var(–ink);
min-height: 100vh;
padding: 2.5rem 1rem 5rem;
}

.container { max-width: 660px; margin: 0 auto; }

/* HEADER */
header { text-align: center; margin-bottom: 3rem; }

.brand-tag {
font-size: 0.68rem;
font-weight: 500;
letter-spacing: 0.25em;
text-transform: uppercase;
color: var(–terracota);
display: block;
margin-bottom: 0.8rem;
}

header h1 {
font-family: ‘Cormorant Garamond’, serif;
font-size: clamp(2.2rem, 7vw, 3.2rem);
font-weight: 300;
color: var(–ink);
line-height: 1.1;
}

header h1 em {
font-style: italic;
font-weight: 400;
color: var(–terracota);
}

header p {
margin-top: 0.8rem;
color: var(–ink-soft);
font-size: 0.85rem;
font-weight: 300;
letter-spacing: 0.02em;
}

.ornament {
display: flex;
align-items: center;
justify-content: center;
gap: 0.8rem;
margin: 1.2rem auto;
}
.ornament::before, .ornament::after {
content: ‘’;
display: block;
width: 50px;
height: 1px;
background: var(–border);
}
.ornament-dot {
width: 5px; height: 5px;
border-radius: 50%;
background: var(–terracota);
opacity: 0.5;
}

/* STEP LABEL */
.step-label {
font-size: 0.62rem;
font-weight: 500;
letter-spacing: 0.2em;
text-transform: uppercase;
color: var(–terracota);
margin-bottom: 1rem;
display: flex;
align-items: center;
gap: 0.5rem;
}
.step-num {
width: 20px; height: 20px;
border-radius: 50%;
border: 1px solid var(–terracota);
display: flex; align-items: center; justify-content: center;
font-size: 0.6rem;
flex-shrink: 0;
}

/* CARDS */
.card {
background: var(–warm-white);
border: 1px solid var(–border);
border-radius: 4px;
padding: 1.8rem;
margin-bottom: 1rem;
}

/* TAMAÑO */
.size-options {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 0.8rem;
}

.size-btn {
border: 1px solid var(–border);
background: white;
border-radius: 4px;
padding: 1.2rem;
cursor: pointer;
transition: all 0.2s;
text-align: left;
font-family: ‘Jost’, sans-serif;
position: relative;
}
.size-btn:hover { border-color: var(–terracota); }
.size-btn.active { border-color: var(–terracota); background: #fdf6f0; }
.size-btn.active::after {
content: ‘✓’;
position: absolute;
top: 0.7rem; right: 0.9rem;
font-size: 0.75rem;
color: var(–terracota);
}
.size-name {
font-family: ‘Cormorant Garamond’, serif;
font-size: 1.1rem;
font-weight: 400;
display: block;
color: var(–ink);
}
.size-detail {
font-size: 0.75rem;
color: var(–ink-soft);
display: block;
margin-top: 0.2rem;
font-weight: 300;
}
.size-price {
font-size: 0.8rem;
font-weight: 500;
color: var(–terracota);
display: block;
margin-top: 0.5rem;
}

/* WORD INPUT */
.word-input {
width: 100%;
border: none;
border-bottom: 2px solid var(–terracota);
padding: 0.8rem 0.2rem;
font-size: 2rem;
font-family: ‘Cormorant Garamond’, serif;
font-weight: 300;
letter-spacing: 0.25em;
text-transform: uppercase;
color: var(–ink);
background: transparent;
outline: none;
transition: border-color 0.2s;
}
.word-input:focus { border-bottom-color: var(–ink); }
.word-input::placeholder {
color: var(–border);
font-style: italic;
font-size: 1.5rem;
letter-spacing: 0.1em;
}
.input-meta {
display: flex;
justify-content: space-between;
margin-top: 0.6rem;
}
.input-hint { font-size: 0.75rem; color: var(–ink-soft); font-weight: 300; }
.char-count  { font-size: 0.75rem; color: var(–terracota); }

/* LETRAS GRID */
.letters-grid {
display: flex;
flex-wrap: wrap;
gap: 0.8rem;
align-items: flex-start;
}

.letter-chip {
display: flex;
flex-direction: column;
align-items: center;
gap: 0.4rem;
position: relative;
animation: popIn 0.18s ease;
}
@keyframes popIn {
from { transform: scale(0.6) translateY(6px); opacity: 0; }
to   { transform: scale(1)   translateY(0);   opacity: 1; }
}

.letter-bubble {
width: 52px; height: 52px;
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
font-family: ‘Cormorant Garamond’, serif;
font-size: 1.4rem;
font-weight: 600;
color: white;
text-shadow: 0 1px 3px rgba(0,0,0,0.28);
cursor: pointer;
transition: transform 0.15s, box-shadow 0.15s;
border: 3px solid transparent;
}
.letter-bubble:hover {
transform: scale(1.1);
box-shadow: 0 6px 16px rgba(0,0,0,0.18);
}
.letter-bubble.no-color {
background: var(–blush) !important;
color: var(–ink-soft);
border: 2px dashed var(–border);
text-shadow: none;
}
.letter-bubble.has-color { box-shadow: 0 3px 10px rgba(0,0,0,0.2); }
.letter-bubble.light-bubble { color: var(–ink); text-shadow: none; }

.letter-name {
font-size: 0.58rem;
color: var(–ink-soft);
text-align: center;
max-width: 60px;
line-height: 1.3;
font-weight: 300;
white-space: nowrap;
overflow: hidden;
text-overflow: ellipsis;
}
.letter-name.pending { color: var(–border); font-style: italic; }

/* COLOR POPUP */
.color-popup {
display: none;
position: absolute;
bottom: calc(100% + 10px);
left: 50%;
transform: translateX(-50%);
background: white;
border: 1px solid var(–border);
border-radius: 4px;
padding: 0.9rem;
box-shadow: 0 12px 32px rgba(0,0,0,0.14);
z-index: 200;
width: 224px;
}
.color-popup.open { display: block; }

.popup-title {
font-size: 0.62rem;
letter-spacing: 0.15em;
text-transform: uppercase;
color: var(–ink-soft);
margin-bottom: 0.7rem;
text-align: center;
}

.swatches-grid {
display: grid;
grid-template-columns: repeat(5, 1fr);
gap: 0.4rem;
justify-items: center;
}

.color-swatch {
width: 32px; height: 32px;
border-radius: 50%;
cursor: pointer;
transition: transform 0.15s, box-shadow 0.1s;
position: relative;
border: 2px solid rgba(0,0,0,0.06);
}
.color-swatch:hover { transform: scale(1.18); box-shadow: 0 3px 8px rgba(0,0,0,0.2); }
.color-swatch.selected { border-color: var(–ink) !important; }
.color-swatch.selected::after {
content: ‘✓’;
position: absolute;
top: 50%; left: 50%;
transform: translate(-50%, -50%);
color: white;
font-size: 0.75rem;
font-weight: bold;
text-shadow: 0 1px 3px rgba(0,0,0,0.5);
}
.color-swatch.light-swatch.selected::after { color: var(–ink); text-shadow: none; }

.swatch-tooltip {
font-size: 0.62rem;
text-align: center;
color: var(–ink-soft);
margin-top: 0.5rem;
min-height: 1rem;
font-style: italic;
}

/* SUMMARY */
.summary-card {
background: var(–ink);
color: white;
border-radius: 4px;
padding: 2rem;
margin-top: 1rem;
}
.summary-heading {
font-family: ‘Cormorant Garamond’, serif;
font-size: 1.4rem;
font-weight: 300;
font-style: italic;
color: rgba(255,255,255,0.5);
margin-bottom: 1.4rem;
}
.summary-row {
display: flex;
justify-content: space-between;
align-items: center;
padding: 0.5rem 0;
border-bottom: 1px solid rgba(255,255,255,0.07);
font-size: 0.83rem;
}
.summary-row .lbl { color: rgba(255,255,255,0.4); font-weight: 300; }

.total-block {
margin-top: 1.2rem;
padding-top: 1.2rem;
border-top: 1px solid rgba(255,255,255,0.18);
display: flex;
justify-content: space-between;
align-items: flex-end;
}
.total-lbl {
font-size: 0.62rem;
letter-spacing: 0.2em;
text-transform: uppercase;
color: rgba(255,255,255,0.3);
}
.total-price {
font-family: ‘Cormorant Garamond’, serif;
font-size: 2.5rem;
font-weight: 300;
line-height: 1;
text-align: right;
}
.transfer-note {
font-size: 0.72rem;
color: rgba(255,255,255,0.3);
margin-top: 0.3rem;
text-align: right;
font-weight: 300;
}
.transfer-note strong { color: #a8d4a8; font-weight: 400; }

/* LEGEND */
.legend {
margin-top: 1.3rem;
padding-top: 1.1rem;
border-top: 1px solid rgba(255,255,255,0.07);
}
.legend-title {
font-size: 0.58rem;
letter-spacing: 0.2em;
text-transform: uppercase;
color: rgba(255,255,255,0.22);
margin-bottom: 0.6rem;
}
.legend-items { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
.legend-item {
display: flex;
align-items: center;
gap: 0.35rem;
font-size: 0.73rem;
color: rgba(255,255,255,0.55);
}
.legend-dot {
width: 12px; height: 12px;
border-radius: 50%;
flex-shrink: 0;
border: 1px solid rgba(255,255,255,0.12);
}

/* WA BUTTON */
.wa-btn {
display: flex;
align-items: center;
justify-content: center;
gap: 0.7rem;
width: 100%;
margin-top: 1.2rem;
padding: 1rem 1.5rem;
background: var(–wa-green);
color: white;
border: none;
border-radius: 4px;
font-family: ‘Jost’, sans-serif;
font-size: 0.88rem;
font-weight: 500;
letter-spacing: 0.06em;
cursor: pointer;
text-decoration: none;
transition: background 0.2s, transform 0.15s;
}
.wa-btn:hover { background: #1ebe5d; transform: translateY(-1px); }

.pending-warn {
font-size: 0.72rem;
color: rgba(255,255,255,0.28);
text-align: center;
margin-top: 0.7rem;
font-style: italic;
}

/* OVERLAY */
.overlay { display: none; position: fixed; inset: 0; z-index: 100; }
.overlay.open { display: block; }

@media (max-width: 420px) {
.size-options { grid-template-columns: 1fr; }
.letter-bubble { width: 44px; height: 44px; font-size: 1.15rem; }
.color-swatch { width: 28px; height: 28px; }
.color-popup { width: 196px; }
}
</style>

</head>
<body>

<div class="overlay" id="overlay" onclick="closeAllPopups()"></div>

<div class="container">

  <header>
    <span class="brand-tag">Anita Miró Ceramics</span>
    <h1>Calculá tus <em>letras</em></h1>
    <div class="ornament"><div class="ornament-dot"></div></div>
    <p>Elegí el tamaño, escribí tu palabra y seleccioná el color de cada letra</p>
  </header>

  <!-- PASO 1 -->

  <div class="card">
    <div class="step-label"><span class="step-num">1</span> Tamaño</div>
    <div class="size-options">
      <button class="size-btn active" onclick="selectSize(this, 36750, 'Bubble Original · 12 cm')">
        <span class="size-name">Bubble Original</span>
        <span class="size-detail">aprox. 12 cm de alto</span>
        <span class="size-price">$36.750 por letra</span>
      </button>
      <button class="size-btn" onclick="selectSize(this, 25500, 'Bubble Mini · 8 cm')">
        <span class="size-name">Bubble Mini</span>
        <span class="size-detail">aprox. 8 cm de alto</span>
        <span class="size-price">$25.500 por letra</span>
      </button>
    </div>
  </div>

  <!-- PASO 2 -->

  <div class="card">
    <div class="step-label"><span class="step-num">2</span> Nombre o palabra</div>
    <input
      class="word-input"
      type="text"
      id="wordInput"
      maxlength="20"
      placeholder="MAGUI"
      oninput="handleInput(this.value)"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
    >
    <div class="input-meta">
      <span class="input-hint">Solo letras · hasta 20 caracteres</span>
      <span class="char-count"><span id="charCount">0</span> letras</span>
    </div>
  </div>

  <!-- PASO 3 -->

  <div class="card" id="colorCard" style="display:none">
    <div class="step-label"><span class="step-num">3</span> Color de cada letra</div>
    <div class="letters-grid" id="lettersGrid"></div>
  </div>

  <!-- RESUMEN -->

  <div class="summary-card" id="summaryCard" style="display:none">
    <div class="summary-heading">Resumen del pedido</div>
    <div id="summaryRows"></div>
    <div class="total-block">
      <div class="total-lbl">Total estimado</div>
      <div>
        <div class="total-price" id="totalPrice"></div>
        <div class="transfer-note" id="transferNote"></div>
      </div>
    </div>
    <div class="legend" id="legend" style="display:none">
      <div class="legend-title">Detalle de colores</div>
      <div class="legend-items" id="legendItems"></div>
    </div>
    <div id="pendingWarn"></div>
    <a class="wa-btn" id="waBtn" href="#" target="_blank">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      Pedir por WhatsApp
    </a>
  </div>

</div>

<script>
// ─── PALETA REAL — Anita Miró Abril 2026 ──────────────────
const COLORS = [
  { id: 'rosa-fuerte',    label: 'Rosa Fuerte',    hex: '#d4687a', light: false },
  { id: 'rojo-navidad',   label: 'Rojo Navidad',   hex: '#c0272d', light: false },
  { id: 'blanco',         label: 'Blanco',          hex: '#f8f6f2', light: true  },
  { id: 'celeste-pastel', label: 'Celeste Pastel', hex: '#a8cce0', light: false },
  { id: 'rosa-pastel',    label: 'Rosa Pastel',    hex: '#f0c0b0', light: true  },
  { id: 'lila',           label: 'Lila',            hex: '#9b90c8', light: false },
  { id: 'caramel',        label: 'Caramel',         hex: '#c8900a', light: false },
  { id: 'amarillo-claro', label: 'Amarillo Claro', hex: '#f0e070', light: true  },
  { id: 'amarillo',       label: 'Amarillo',        hex: '#f2c800', light: true  },
  { id: 'azul-cobalto',   label: 'Azul Cobalto',   hex: '#1a2a6c', light: false },
  { id: 'lavanda',        label: 'Lavanda',         hex: '#9aafcc', light: false },
  { id: 'negro',          label: 'Negro',           hex: '#1e1810', light: false },
  { id: 'crudo',          label: 'Crudo',           hex: '#f2ead8', light: true  },
  { id: 'verde-agua',     label: 'Verde Agua',      hex: '#7ec49a', light: false },
  { id: 'naranja',        label: 'Naranja',         hex: '#e86820', light: false },
  { id: 'verde-petroleo', label: 'Verde Petróleo',  hex: '#2a8a78', light: false },
  { id: 'uva',            label: 'Uva',             hex: '#7a1a28', light: false },
  { id: 'verde-ingles',   label: 'Verde Inglés',   hex: '#1a5c30', light: false },
  { id: 'crudo-mate',     label: 'Crudo Mate',     hex: '#e8dfc8', light: true  },
];

// ─── ESTADO ───────────────────────────────────────────────
let currentWord  = '';
let letterColors = {};
let pricePerLetter = 36750;
let sizeName = 'Bubble Original · 12 cm';

// ─── TAMAÑO ───────────────────────────────────────────────
function selectSize(btn, price, name) {
  document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  pricePerLetter = price;
  sizeName = name;
  updateSummary();
}

// ─── INPUT ────────────────────────────────────────────────
function handleInput(val) {
  currentWord = val.toUpperCase().replace(/[^A-ZÁÉÍÓÚÜÑ ]/gi, '');
  document.getElementById('wordInput').value = currentWord;
  document.getElementById('charCount').textContent = currentWord.replace(/ /g, '').length;

  const newColors = {};
  for (let i = 0; i < currentWord.length; i++) {
    if (letterColors[i]) newColors[i] = letterColors[i];
  }
  letterColors = newColors;
  render();
}

// ─── RENDER LETRAS ────────────────────────────────────────
function render() {
  const colorCard  = document.getElementById('colorCard');
  const summaryCard = document.getElementById('summaryCard');
  const grid = document.getElementById('lettersGrid');
  const letters = currentWord.split('');

  if (!letters.length || !currentWord.replace(/ /g, '').length) {
    colorCard.style.display = 'none';
    summaryCard.style.display = 'none';
    return;
  }

  colorCard.style.display = 'block';
  grid.innerHTML = '';

  letters.forEach((char, i) => {
    if (char === ' ') {
      const sp = document.createElement('div');
      sp.style.cssText = 'width:16px';
      grid.appendChild(sp);
      return;
    }

    const colorId = letterColors[i];
    const color   = COLORS.find(c => c.id === colorId);
    const bg      = color ? color.hex : null;

    const chip = document.createElement('div');
    chip.className = 'letter-chip';
    chip.innerHTML = `
      <div
        class="letter-bubble ${bg ? 'has-color' : 'no-color'}${color && color.light ? ' light-bubble' : ''}"
        style="${bg ? `background:${bg}` : ''}"
        onclick="togglePopup(event,${i})"
      >${char}</div>
      <div class="color-popup" id="popup-${i}">
        <div class="popup-title">Color para "${char}"</div>
        <div class="swatches-grid">
          ${COLORS.map(c => `
            <div
              class="color-swatch ${colorId === c.id ? 'selected' : ''} ${c.light ? 'light-swatch' : ''}"
              style="background:${c.hex}"
              title="${c.label}"
              onclick="pickColor(event,${i},'${c.id}')"
              onmouseenter="showTooltip(${i},'${c.label}')"
              onmouseleave="clearTooltip(${i})"
            ></div>
          `).join('')}
        </div>
        <div class="swatch-tooltip" id="tip-${i}"></div>
      </div>
      <div class="letter-name ${color ? '' : 'pending'}">${color ? color.label : '·'}</div>
    `;
    grid.appendChild(chip);
  });

  updateSummary();
}

// ─── POPUP ────────────────────────────────────────────────
function togglePopup(e, idx) {
  e.stopPropagation();
  const popup   = document.getElementById(`popup-${idx}`);
  const overlay = document.getElementById('overlay');
  const isOpen  = popup.classList.contains('open');
  closeAllPopups();
  if (!isOpen) { popup.classList.add('open'); overlay.classList.add('open'); }
}

function closeAllPopups() {
  document.querySelectorAll('.color-popup').forEach(p => p.classList.remove('open'));
  document.getElementById('overlay').classList.remove('open');
}

function pickColor(e, idx, colorId) {
  e.stopPropagation();
  letterColors[idx] = colorId;
  closeAllPopups();
  render();
}

function showTooltip(idx, label) {
  const el = document.getElementById(`tip-${idx}`);
  if (el) el.textContent = label;
}
function clearTooltip(idx) {
  const el = document.getElementById(`tip-${idx}`);
  if (el) el.textContent = '';
}

// ─── RESUMEN ──────────────────────────────────────────────
function updateSummary() {
  const summaryCard = document.getElementById('summaryCard');
  const letters = currentWord.replace(/ /g, '').split('').filter(Boolean);
  if (!letters.length) { summaryCard.style.display = 'none'; return; }

  summaryCard.style.display = 'block';

  const total         = letters.length * pricePerLetter;
  const transferTotal = Math.round(total * 0.9);

  document.getElementById('totalPrice').textContent = formatARS(total);
  document.getElementById('transferNote').innerHTML =
    `<strong>${formatARS(transferTotal)}</strong> con transferencia bancaria`;

  document.getElementById('summaryRows').innerHTML = `
    <div class="summary-row">
      <span class="lbl">Tamaño</span>
      <span class="val">${sizeName}</span>
    </div>
    <div class="summary-row">
      <span class="lbl">Cantidad de letras</span>
      <span class="val">${letters.length}</span>
    </div>
    <div class="summary-row">
      <span class="lbl">Precio por letra</span>
      <span class="val">${formatARS(pricePerLetter)}</span>
    </div>
  `;

  // leyenda
  const assignments = [];
  currentWord.split('').forEach((char, i) => {
    if (char !== ' ' && letterColors[i]) {
      const c = COLORS.find(x => x.id === letterColors[i]);
      if (c) assignments.push({ char, color: c });
    }
  });

  const legendEl = document.getElementById('legend');
  if (assignments.length) {
    legendEl.style.display = 'block';
    document.getElementById('legendItems').innerHTML = assignments.map(({ char, color }) =>
      `<div class="legend-item">
        <div class="legend-dot" style="background:${color.hex}"></div>
        ${char}: ${color.label}
      </div>`
    ).join('');
  } else {
    legendEl.style.display = 'none';
  }

  // pending
  const pending = letters.length - Object.keys(letterColors).length;
  document.getElementById('pendingWarn').innerHTML = pending > 0
    ? `<p class="pending-warn">Falta elegir color para ${pending} letra${pending > 1 ? 's' : ''}</p>`
    : '';

  buildWALink(total, transferTotal);
}

function formatARS(n) {
  return '$' + n.toLocaleString('es-AR');
}

function buildWALink(total, transferTotal) {
  const colorLines = currentWord.split('').map((char, i) => {
    if (char === ' ') return null;
    const c = COLORS.find(x => x.id === letterColors[i]);
    return `  ${char}: ${c ? c.label : 'a definir'}`;
  }).filter(Boolean).join('\n');

  const msg = encodeURIComponent(
    `¡Hola Anita! 👋 Quiero encargar mis letras personalizadas.\n\n` +
    `📝 Palabra: ${currentWord}\n` +
    `📏 Tamaño: ${sizeName}\n` +
    `🎨 Colores:\n${colorLines}\n\n` +
    `💰 Total estimado: ${formatARS(total)}\n` +
    `   Con transferencia: ${formatARS(transferTotal)}\n\n` +
    `¿Me confirmás disponibilidad y tiempo de entrega? ¡Gracias!`
  );

  document.getElementById('waBtn').href = `https://wa.me/5491159381980?text=${msg}`;
}
</script>

